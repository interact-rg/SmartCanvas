# Base image
FROM python:3.12-slim AS base

# Set environment variables
ENV POETRY_HOME="/opt/poetry" \
    PATH="/root/.local/bin:$PATH" \
    POETRY_VIRTUALENVS_CREATE=true \
    PYTHONUNBUFFERED=1 \
    FLASK_APP=web \
    FLASK_ENV=production

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget xz-utils build-essential && \
    rm -rf /var/lib/apt/lists/*

# Install Poetry
RUN pip install --no-cache-dir poetry

# Install FFmpeg
RUN wget https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl-shared.tar.xz && \
    tar -xvf ffmpeg-master-latest-linux64-gpl-shared.tar.xz && \
    mv ffmpeg-master-latest-linux64-gpl-shared/bin/ffmpeg /usr/local/bin/ && \
    mv ffmpeg-master-latest-linux64-gpl-shared/bin/ffprobe /usr/local/bin/ && \
    rm -rf ffmpeg-master-latest-linux64-gpl-shared* 

# Create a non-root user
RUN adduser --disabled-password --gecos "" appuser
USER appuser

# Set working directory for non-root user
WORKDIR /home/appuser

# Copy dependency files and install Python packages
COPY --chown=appuser:appuser pyproject.toml poetry.lock ./
RUN poetry install --no-root --without dev --no-interaction --no-ansi


# Copy backend source code
COPY --chown=appuser:appuser smart_canvas /home/appuser/smart_canvas
COPY --chown=appuser:appuser models /home/appuser/models
COPY --chown=appuser:appuser web /home/appuser/web

# Expose Flask port
EXPOSE 5000

# Start Flask server
CMD ["poetry", "run", "flask", "run", "--host=0.0.0.0"]
